# Telefonistka Development Environment Variables
# Copy this file to .env and fill in your values:
# cp .env.example .env

# ===== REQUIRED =====

# GitHub Personal Access Token with 'repo' scope
# Get one from: https://github.com/settings/tokens
GITHUB_OAUTH_TOKEN=ghp_yourTokenHere

# Secret for validating GitHub webhook payloads
# Generate a random string: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ===== OPTIONAL (for GitHub App authentication) =====

# If you prefer using GitHub App instead of Personal Access Token
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# For auto-approving PRs (optional, requires separate token)
# APPROVER_GITHUB_OAUTH_TOKEN=ghp_anotherTokenHere
# APPROVER_GITHUB_APP_ID=123456
# APPROVER_GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# ===== ARGOCD INTEGRATION (optional) =====

# ArgoCD server address (without http/https)
# Examples:
# - For in-cluster: argocd-server.argocd.svc.cluster.local:443
# - For local: localhost:8080
ARGOCD_SERVER_ADDR=argocd-server.argocd.svc.cluster.local:443

# ArgoCD authentication token
# Get from: argocd account generate-token
ARGOCD_TOKEN=your_argocd_token_here

# Disable TLS (useful for local testing)
ARGOCD_PLAINTEXT=false

# Skip TLS certificate verification (useful for self-signed certs)
ARGOCD_INSECURE=false

# ===== ADVANCED OPTIONS =====

# GitHub Enterprise Server hostname (if applicable)
# GITHUB_HOST=github.example.com

# Custom templates path
# TEMPLATES_PATH=./templates

# Handle comments made by self (useful for local testing)
# HANDLE_SELF_COMMENT=true

# Custom commit status URL template
# CUSTOM_COMMIT_STATUS_URL_TEMPLATE_PATH=/path/to/template.gotmpl
